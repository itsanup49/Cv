        <span class="skill">Social Media</span>
      </div>
    </div>
    <div>
      <div class="sec-title">Languages</div>
      <div class="skills-grid">
        <span class="skill">English — Fluent</span>
        <span class="skill">Nepali — Native</span>
      </div>
    </div>
  </div>

</div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Anup Neupane – CV</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #e8e4df;
    font-family: 'DM Sans', sans-serif;
    color: #1a1a1a;
    padding: 32px 16px;
  }

  .page {
    background: #ffffff;
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 18mm;
    box-shadow: 0 8px 48px rgba(0,0,0,0.14);
  }

  .header {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    padding-bottom: 22px;
    border-bottom: 2px solid #1a1a1a;
    margin-bottom: 28px;
  }

  .photo {
    width: 100px;
    height: auto;
    border-radius: 3px;
    flex-shrink: 0;
    display: block;
  }

  .header-info { padding-top: 4px; }

  .name {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.5px;
    line-height: 1.05;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 18px;
    margin-top: 10px;
  }

  .contact-list span {
    font-size: 12.5px;
    color: #444;
    font-weight: 300;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .contact-list svg { opacity: 0.5; flex-shrink: 0; }

  .section { margin-bottom: 26px; }

  .sec-title {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 12px;
    padding-bottom: 5px;
    border-bottom: 1px solid #e0e0e0;
  }

  .exp-block { margin-bottom: 20px; }
  .exp-block:last-child { margin-bottom: 0; }

  .exp-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .exp-title {
    font-family: 'EB Garamond', serif;
    font-size: 19px;
    font-weight: 600;
  }

  .exp-type {
    font-size: 11.5px;
    color: #888;
    font-weight: 300;
  }

  .exp-desc {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.8;
    color: #3a3a3a;
    font-weight: 300;
  }

  .edu-block { margin-bottom: 14px; }
  .edu-block:last-child { margin-bottom: 0; }

  .edu-title {
    font-family: 'EB Garamond', serif;
    font-size: 19px;
    font-weight: 600;
  }

  .edu-meta {
    font-size: 12.5px;
    color: #555;
    font-weight: 300;
    margin-top: 3px;
  }

  .skills-grid { display: flex; flex-wrap: wrap; gap: 8px; }

  .skill {
    font-size: 12.5px;
    font-weight: 400;
    color: #333;
    padding: 5px 14px;
    border: 1px solid #d8d8d8;
    border-radius: 2px;
    background: #fafafa;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }

  @media print {
    body { background: #fff; padding: 0; }
    .page { width: 100%; min-height: auto; box-shadow: none; padding: 15mm 18mm; }
  }

  @media screen and (max-width: 640px) {
    .page { width: 100%; padding: 24px; }
    .name { font-size: 26px; }
    .two-col { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
</head>
<body>
<div class="page">

  <div class="header">
